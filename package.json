{
  "name": "assets-produce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "install:agent": "bun --cwd=agent install",
    "install:all": "bun install && bun --cwd=agent install",
    "agent:build": "bun --cwd=agent run build",
    "agent:size": "du -h agent/dist/agent.mjs agent/packages/opencode/dist/agent.mjs",
    "videoctl:build": "make -C videoctl build",
    "videoctl:test": "make -C videoctl test"
  }
}
