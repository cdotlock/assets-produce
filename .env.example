# assets-produce — environment template (current through Phase 5)
#
# Usage:
#   cp .env.example .env  &&  edit .env
# .env is gitignored; .env.example tracks every field the agent reads at
# runtime so reviewers can diff and spot drift.
#
# Field-set check:
#   diff <(grep -oE '^[A-Z_]+' .env.example | sort -u) \
#        <(grep -oE '^[A-Z_]+' .env | sort -u)
# (zero diff means in sync; .env may have extra dev-only fields.)

# ----- 服务端口 -----
AGENT_PORT=8001

# ----- 存储路径 -----
# Default: <Global.Path.data>/agent.db (e.g. ~/.local/share/agent/agent.db)
# Override for testing or co-location with project files.
# AGENT_DB_PATH=

# ----- Anthropic (Claude — 主脑, prompt cache enabled in transform.ts) -----
# Phase 2 spec  10:  agent run "say hi"  must run via Claude.
ANTHROPIC_API_KEY=

# ----- mob-ai LLM gateway (Claude 主脑默认经此 — spec §15 r1.16) -----
# opencode.jsonc 注册了 provider "mob-ai" (@ai-sdk/openai-compatible,
# baseURL https://ai.mob-ai.cn/v1) 且顶层 model = mob-ai/claude-opus-4-6:free。
# opencode 从本环境变量读取该 provider 的 key (ConfigProvider env:["MOB_AI_API_KEY"]).
# ⚠ 经此网关 (litellm OpenAI-compat) Anthropic ephemeral prompt cache 实测
#   不生效 (两次相同长前缀 cache_creation/read 恒 0) —— 详见 spec §15 r1.16。
#   功能完全不受影响，仅丢失重复前缀的成本/延迟优化。
# 留空时主脑回退 DeepSeek (若 DEEPSEEK_API_KEY 设置)，否则报"无可用模型"。
MOB_AI_API_KEY=

# ----- DeepSeek (fallback / 国产合规) -----
# DeepSeek auto-loads via models.dev catalog when DEEPSEEK_API_KEY is set;
# uses the OpenAI-compatible adapter, base URL defaults to api.deepseek.com.
# Phase 2 spec  10:  agent run --model deepseek/deepseek-chat must run.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # only override for self-hosted

# ----- Langfuse (skill body + prompt management) -----
# Project: assets-produce.
# Phase 2 spec  10: smoke script can fetch one prompt by name.
# spec §15 r1.17: asset-generation skill bodies are Langfuse-`production`-
# first with a git-canonical local fallback. Missing PUBLIC/SECRET keys =>
# loader degrades to pure-local (no crash); `skills sync` errors readably.
LANGFUSE_HOST=https://prompt.mobai-game.com
LANGFUSE_PROJECT=assets-produce
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# In-process TTL (ms) for the Langfuse-backed skill-body loader. A
# Langfuse hot-edit to `production` takes ~1 TTL to propagate; keeps
# Langfuse off the per-job hot path. Unset/blank => default 60000. <=0
# disables caching (every job re-resolves — not recommended in prod).
ASSETS_SKILL_LANGFUSE_TTL_MS=60000

# ----- 阿里云 OSS -----
# Phase 2 spec  10:  agent oss put / get / list  must round-trip a file.
OSS_REGION=cn-shanghai
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

# ----- Phase 3 atomic tool FC endpoints -----
# Each tool calls a Function Compute endpoint with Bearer token.
# When unset, the tool surfaces a config error in chat (does not throw).
# Phase 3 spec § 10: agent tools list / export-schema / chat invocation.
# Tool ↔ env mapping:
#   generate-image-nanobanana  → nanobanana 2 / gemini-3.1-flash-image-preview
#   generate-image-gpt         → OpenAI GPT-Image
#   generate-video-seedance    → SeedDance 2 pro
#   generate-video-happyhorse  → HappyHorse (Kling-style multimodal video)
#   concat-clips / crop-video  → FFmpeg-style ops, no AI model
FC_GENERATE_IMAGE_NANOBANANA_URL=
FC_GENERATE_IMAGE_NANOBANANA_TOKEN=
FC_GENERATE_IMAGE_GPT_URL=
FC_GENERATE_IMAGE_GPT_TOKEN=
FC_GENERATE_VIDEO_SEEDANCE_URL=
FC_GENERATE_VIDEO_SEEDANCE_TOKEN=
FC_GENERATE_VIDEO_HAPPYHORSE_URL=
FC_GENERATE_VIDEO_HAPPYHORSE_TOKEN=
FC_CONCAT_CLIPS_URL=
FC_CONCAT_CLIPS_TOKEN=
FC_CROP_VIDEO_URL=
FC_CROP_VIDEO_TOKEN=

# ----- Runtime flags (Phase 4 + Phase 5 lead-in) -----
# OPENCODE_PURE=1 disables external opencode plugins (e.g. user-global
# oh-my-openagent which replaces the default agent and skill tool). Set this
# when running `agent run` for skill E2E tests to ensure managed skills
# (DB + Langfuse) are visible. WebUI / `agent serve` does not need it.
# OPENCODE_PURE=1
#
# OPENCODE_SERVER_PASSWORD enables basicAuth on `agent serve` HTTP routes
# (incl. /api/skills). REQUIRED when binding to non-loopback interface;
# strongly recommended for any shared host. Phase 5 WebUI will gate on
# session/JWT instead — leave unset for local-only dev.
# OPENCODE_SERVER_PASSWORD=

# ----- Phase 5 WebUI auth -----
# JWT signing key for /api/auth/* tokens. Must be ≥ 32 chars random hex/base64.
# Generate one: `openssl rand -hex 32`
# Without this, `agent serve` will reject all login attempts.
JWT_SECRET=

# ----- Phase 5 WebUI agent connection (cont.) -----
# Where the WebUI fetches the agent server. Default 127.0.0.1:8001 (loopback).
# Override only when running web on a different host than the agent.
NEXT_PUBLIC_AGENT_HTTP_BASE_URL=http://127.0.0.1:8001

# ----- WebUI — Langfuse link base (used by /skills page) -----
NEXT_PUBLIC_LANGFUSE_HOST=https://prompt.mobai-game.com

# ----- Phase 8 Asset Service (REST API at /api/v1/assets/*) -----
# Three Bearer tokens per design doc § 5.5. Each token has its own project
# allowlist; the asset-service auth middleware (see
# agent/packages/opencode/src/business/asset-service/http/auth.ts) maps
# Bearer <value> → {name, projects} for the per-route 403 check.
#
# Token slot conventions:
#   NTMS  novels-to-moonscript  — Phase 10 caller for asset.lookup
#   MSB   moonshort-backend     — Phase 10 caller for asset.create / status
#   DEV   local development     — usually projects=*
#
# Leave any unused slot blank; loadAssetAuthFromEnv() skips empty values.
# ASSETS_API_PROJECTS_* is CSV ("p1,p2") or literal "*" for "all projects".
#
# Phase 10 收口的 project_id 命名约定：`<source>_<slug>`
#   - novel 来源：`novel_silver_moon_manor`, `novel_no_rules_in_bad_ideas`
#   - 内部 demo：`internal_<slug>`, `dev_<slug>`
# NTMS / MSB 的默认允许范围建议都是 `novel_*` 系列；DEV 用 `*` 全通。
# Token 治理流程（发放 / rotate / 紧急吊销 / 故障排查）见
# docs/ops/three-repo-token-flow.md。

ASSETS_API_TOKEN_NTMS=
# 示例：ASSETS_API_PROJECTS_NTMS=novel_silver_moon_manor,novel_no_rules_in_bad_ideas
ASSETS_API_PROJECTS_NTMS=

ASSETS_API_TOKEN_MSB=
# 示例：ASSETS_API_PROJECTS_MSB=novel_silver_moon_manor,novel_no_rules_in_bad_ideas
ASSETS_API_PROJECTS_MSB=

ASSETS_API_TOKEN_DEV=
ASSETS_API_PROJECTS_DEV=*

# Mini agent loop budgets (resolved in
# agent/.../asset-service/budget.ts). Both default when the env is
# unset/invalid: step budget → 30 (DEFAULT_MAX_STEPS), token budget →
# 200000. Phase 14 (spec §15/1.14) wired the real LLM-driven loop, which
# enforces BOTH as backstops (over-budget → BUDGET_EXCEEDED).
ASSETS_SERVICE_MAX_STEPS_PER_JOB=30
ASSETS_SERVICE_MAX_TOKENS_PER_JOB=200000

# ----- Phase 9 — Asset Tools (cg-render / upscale / oss-sync) -----
# Real (non-mock) cg-render goes through ZENMUX's gemini-image-preview model.
# Leave blank to run cg-render exclusively in `mock: true` mode (writes a
# 1×1 placeholder PNG). The wrapper falls back to mock when ZENMUX_API_KEY
# is missing AND the caller didn't explicitly request real mode.
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api

# Optional path override — if the per-tool venv interpreter (`tools/<name>/
# .venv/bin/python3`) is not present, the atomic-tool wrappers fall back to
# PYTHON (if set) or `python3` on PATH.
# PYTHON=/opt/homebrew/bin/python3.12

# ----- Phase 11 — Audio Tools (sfx / music) -----
# generate-sfx-elevenlabs is the REAL sound-effects path: it calls
# ElevenLabs POST /v1/sound-generation, then uploads the mp3 to OSS
# inline. ELEVENLABS_API_KEY is required to enable it; when unset the
# tool surfaces a config error in chat (does not throw).
# NOTE: generate-sfx-elevenlabs also requires the existing aliyun OSS
# credentials block above (OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET /
# OSS_BUCKET / OSS_REGION / OSS_ENDPOINT) — it uploads the synthesized
# clip itself and returns a permanent OSS https URL.
ELEVENLABS_API_KEY=
# Optional override; default shown. Only change for a proxy / self-host.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Suno (music) — INTENTIONALLY DEFERRED, no env to set.
# generate-music-suno reads NO environment variables: per master spec
# §15 row 1.13 Suno has no official first-party public API, every public
# "Suno API" is a reverse-engineered third-party gateway, and a gateway
# has not been selected. The tool is a deterministic placeholder
# (returns metadata.placeholder:true, no HTTP / no OSS). When a gateway
# is later chosen, a §15 revision will add the live vars here, e.g.:
# SUNO_API_KEY=
# SUNO_BASE_URL=
# Until then, do NOT add these — the music tool would ignore them.

# ----- Phase 13 — Image Processing -----
# MODNet repo clone path, read by tools/matting/matting.py (os.environ.get).
# Only required for non-mock matting (MODNet ML background removal).
# Mock mode (mock: true) writes a 1×1 RGBA placeholder and needs nothing.
MODNET_REPO_PATH=
#
# All other Phase-13 tools (cutout / hole-fill / green-spill-clear /
# rgb-unspill / hybrid-to-webp / detect-matting) read NO environment
# variables. Their former backend CHROMAKEY_* and similar settings are
# now explicit JSON params passed at call time — not env vars.
