{
  "$schema": "https://opencode.ai/config.json",
  "model": "mob-ai/claude-opus-4-6:free",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (OpenAI-compatible)",
      "options": {
        "baseURL": "https://api.deepseek.com"
      }
    },
    "mob-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mob-ai (OpenAI-compatible LLM gateway)",
      "env": ["MOB_AI_API_KEY"],
      "options": {
        "baseURL": "https://ai.mob-ai.cn/v1"
      },
      "models": {
        "claude-opus-4-6:free": { "name": "Claude Opus 4.6 (mob-ai, free)" },
        "claude-sonnet-4-6:free": { "name": "Claude Sonnet 4.6 (mob-ai, free)" },
        "claude-opus-4-7:free": { "name": "Claude Opus 4.7 (mob-ai, free)" }
      }
    }
  },
  "skills": {
    "paths": ["knowledge/novel-to-ls"]
  }
}
